{
  "name": "companion-module-crewlan-connect",
  "version": "1.1.0",
  "description": "Bitfocus Companion module for CrewLAN Connect.",
  "main": "dist/main.js",
  "type": "module",
  "files": [
    "companion",
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "check": "yarn lint && yarn test && yarn build && yarn companion-module-check",
    "companion-module-check": "node scripts/check-module.mjs",
    "dev": "tsc -p tsconfig.build.json --watch",
    "lint": "eslint .",
    "package": "yarn build && companion-module-build",
    "test": "node --import tsx --test \"tests/**/*.test.ts\""
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bitfocus/companion-module-crewlan-connect.git"
  },
  "engines": {
    "node": ">=22.20 <23",
    "yarn": "^4"
  },
  "dependencies": {
    "@companion-module/base": "~2.0.4"
  },
  "devDependencies": {
    "@companion-module/tools": "^3.0.1",
    "@types/node": "^22.19.17",
    "eslint": "^10.2.0",
    "prettier": "^3.8.3",
    "rimraf": "^6.1.3",
    "tsx": "^4.21.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.59.0"
  },
  "packageManager": "yarn@4.17.0",
  "bugs": {
    "url": "https://github.com/bitfocus/companion-module-crewlan-connect/issues"
  }
}
